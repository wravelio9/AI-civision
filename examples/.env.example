# Salin ke .env dan sesuaikan.

# Port BE Express.
PORT=3000

# URL AI service (FastAPI). Contoh:
#   - lokal            : http://localhost:8000
#   - Cloudflare tunnel : https://<random>.trycloudflare.com
AI_SERVICE_URL=http://localhost:8000

# Ambang confidence default yang diteruskan ke AI.
DEFAULT_CONF=0.5

# Batas ukuran upload video (MB).
MAX_VIDEO_MB=200
